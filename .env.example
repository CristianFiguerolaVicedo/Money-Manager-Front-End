# Direct URL of the Money Manager backend (with the /api/v1.0 context path).
# Only used to wake the free Render instance when the page opens: every API call goes through
# /api/v1.0 on the web's own origin (Vite proxy in development, Netlify proxy in production).
VITE_API_BASE_URL=http://localhost:8080/api/v1.0
